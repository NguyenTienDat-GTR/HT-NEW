# Caddy tự xin và gia hạn chứng chỉ HTTPS (Let's Encrypt) cho từng tên miền trong SITE_HOSTS
# (cách nhau bằng dấu phẩy: tên miền chính, các subdomain giáo phận, staging...).
# Yêu cầu: mọi tên miền đã trỏ về IP server, cổng 80 và 443 đã mở.
{$SITE_HOSTS} {
	encode gzip

	# BE dùng X-Site-Host để biết người dùng đang ở subdomain nào (giới hạn đăng nhập theo giáo phận).
	# header_up ghi đè mọi giá trị client tự gửi, và BE không ra internet nên chỉ Caddy đặt được header này.
	@ws path /ws/*
	reverse_proxy @ws app:{$SERVER_PORT} {
		header_up X-Site-Host {host}
	}

	# Mọi đường dẫn còn lại vào FE (FE tự rewrite /backend/api/* sang BE, giữ nguyên header).
	reverse_proxy fe:3000 {
		header_up X-Site-Host {host}
	}
}

# Môi trường test: trang riêng, app-test + fe-test, database ht_management_test.
{$TEST_HOST} {
	encode gzip

	@ws path /ws/*
	reverse_proxy @ws app-test:1007 {
		header_up X-Site-Host {host}
	}

	reverse_proxy fe-test:3000 {
		header_up X-Site-Host {host}
	}
}
