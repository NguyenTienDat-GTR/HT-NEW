# Mau file .env. Copy thanh .env va dien gia tri that. KHONG commit .env.
# Tren production: dan TOAN BO noi dung .env vao GitHub Secret ten PROD_ENV_FILE.

# Database
DB_NAME=ht_management
DB_USER=ht_user
DB_PASSWORD=change-me
DB_DRIVER=org.postgresql.Driver
# Chi dung khi chay app ngoai Docker (compose tu ghi de bang host "postgres")
DB_URL=jdbc:postgresql://localhost:5432/ht_management

SERVER_PORT=1007

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=ht_rabbit
RABBITMQ_PASSWORD=change-me

# JWT
JWT_ACCESS_SECRET=change-me-at-least-32-chars
JWT_REFRESH_SECRET=change-me-at-least-32-chars
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=ht-management
JWT_AUDIENCE=ht-management-fe
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_ROLE_CODE=SUPER_ADMIN

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Production
APP_FRONTEND_BASE_URL=https://your-fe-domain
APP_WEBSOCKET_ALLOWED_ORIGINS=https://your-fe-domain
# true bat buoc phai co HTTPS, neu khong trinh duyet se khong luu cookie dang nhap
AUTH_COOKIE_SECURE=true
APP_SECURITY_SWAGGER_PUBLIC_ENABLED=false
