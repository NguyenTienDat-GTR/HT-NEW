# Mẫu file .env. Production: dán TOÀN BỘ nội dung .env.prod vào GitHub Secret PROD_ENV_FILE. KHÔNG commit file thật.
DB_NAME=ht_management
DB_USER=ht_user
DB_PASSWORD=change-me
DB_DRIVER=org.postgresql.Driver
SERVER_PORT=1007
REDIS_PASSWORD=change-me
RABBITMQ_USER=ht_rabbit
RABBITMQ_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-at-least-32-chars
JWT_REFRESH_SECRET=change-me-at-least-32-chars
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=ht-management
JWT_AUDIENCE=ht-management-client
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_ROLE_CODE=SUPER_ADMIN
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Tên miền chính; subdomain giáo phận nằm dưới tên miền này. Không có domain thì dùng <ip-gạch-ngang>.sslip.io
APP_SITE_BASE_DOMAIN=1-2-3-4.sslip.io
# Tên miền chính (cố định). Trang giáo phận KHÔNG cần khai báo ở đây: gán diocese.site_subdomain trong database,
# Caddy sẽ tự cấp HTTPS cho <site_subdomain>.<tên-miền-chính> (xem deploy/Caddyfile).
SITE_HOSTS=1-2-3-4.sslip.io
# Tên miền môi trường test (Caddy cấp HTTPS), xem .env.test.example
TEST_HOST=test.1-2-3-4.sslip.io
APP_FRONTEND_BASE_URL=https://1-2-3-4.sslip.io
# Origin được phép mở WebSocket, cách nhau bằng dấu phẩy. Dùng https://*.<tên-miền-chính> để phủ mọi trang giáo phận.
APP_WEBSOCKET_ALLOWED_ORIGINS=https://1-2-3-4.sslip.io,https://*.1-2-3-4.sslip.io
AUTH_COOKIE_SECURE=true
APP_SECURITY_SWAGGER_PUBLIC_ENABLED=false
CLOUDINARY_URL=
MEDIA_ROOT_PREFIX=ht/prod
MEDIA_SIGNING_SECRET=change-me

# --- Cloudflare (xem docs/cloudflare-security.md) ---
# Turnstile (CAPTCHA đăng nhập). Bỏ trống cả hai = tắt. Lấy ở Cloudflare > Turnstile > Add widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Cloudflare Tunnel cho SSH/DB (chỉ cần khi chạy: docker compose --profile tunnel up -d cloudflared)
CLOUDFLARE_TUNNEL_TOKEN=
