# Mẫu cấu hình môi trường TEST (chạy chung máy với production nhưng cách ly hoàn toàn).
# Thật: BE/.env.test (không commit) -> dán vào GitHub Secret TEST_ENV_FILE của repo BE.
# Các khoá JWT/MEDIA_SIGNING_SECRET PHẢI khác production để token test không dùng được trên production.
DB_NAME=ht_management_test
DB_USER=ht_user
DB_PASSWORD=change-me
DB_DRIVER=org.postgresql.Driver
SERVER_PORT=1007
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ht_management_test
SPRING_DATASOURCE_USERNAME=ht_user
SPRING_DATASOURCE_PASSWORD=change-me
# Redis: dùng database số 1 (production dùng số 0)
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=change-me
SPRING_DATA_REDIS_DATABASE=1
# RabbitMQ: vhost riêng để hàng đợi của test và production không lẫn nhau
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=ht_rabbit
SPRING_RABBITMQ_PASSWORD=change-me
SPRING_RABBITMQ_VIRTUAL_HOST=test
JWT_ACCESS_SECRET=change-me-different-from-prod-64-chars
JWT_REFRESH_SECRET=change-me-different-from-prod-64-chars
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=ht-management
JWT_AUDIENCE=ht-management-client
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_ROLE_CODE=SUPER_ADMIN
# Không gửi email thật khi thử trên dữ liệu thật
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=test-no-mail
MAIL_PASSWORD=test-no-mail
APP_SITE_BASE_DOMAIN=example.com
APP_FRONTEND_BASE_URL=https://test.example.com
APP_WEBSOCKET_ALLOWED_ORIGINS=https://test.example.com
AUTH_COOKIE_SECURE=true
APP_SECURITY_SWAGGER_PUBLIC_ENABLED=false
CLOUDINARY_URL=
MEDIA_ROOT_PREFIX=c-lead/test
MEDIA_SIGNING_SECRET=change-me-different-from-prod
SPRING_FLYWAY_IGNORE_MIGRATION_PATTERNS=*:missing,*:future
